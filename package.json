{
  "name": "wheelora-web",
  "type": "module",
  "version": "0.0.1",
  "description": "Educational Astro + Svelte web project for a fast, accessible AI decision wheel experience.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "sync:i18n-themes": "node scripts/sync-mobile-theme-copy.mjs",
    "test:i18n": "bun test src/i18n/*.test.ts",
    "test:i18n:build": "bun run build && bun scripts/check-localized-build.ts",
    "postbuild": "node scripts/clean-sitemap.js",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "0.3.1",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.1.3",
    "lucide-svelte": "1.0.1",
    "svelte": "5.56.7",
    "vite": "8.1.5"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "sharp": "0.35.3",
    "svgo": "4.0.2"
  },
  "packageManager": "bun@1.3.14"
}
