---
import BaseLayout from "../layouts/BaseLayout.astro";
import WebDemoApp from "../components/svelte/WebDemoApp.svelte";
import ThemeShowcase from "../components/svelte/ThemeShowcase.svelte";
import { aiTones, lifeAreas, site, starterPacks } from "../data/site";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Wheelora™ | The Smartest AI Decision Wheel & Spin App",
  url: site.url,
  description: site.description,
  about: {
    "@type": "SoftwareApplication",
    name: site.shortName,
  },
};
---

<BaseLayout
  title="Wheelora™ | The Smartest AI Decision Wheel App"
  description="Stop overthinking with Wheelora™. Build smarter decision wheels with AI, launch starter packs, adjust weights, and spin to decide fast."
  canonicalPath="/"
  structuredData={[pageSchema]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="pill">AI Decision Wheel</div>
        <h1 class="hero-title">
          Stop overthinking
          <br />
          Let AI Decide
        </h1>
        <p>
          Drop your messy thoughts. Let AI structure the options. Give your decision the ceremony of
          a realistic spin.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="#waitlist">Join waitlist</a>
          <a class="button button-secondary" href="#tones">See AI Tones</a>
        </div>
      </div>

      <div id="demo" class="hero-wheel-wrapper">
        <WebDemoApp client:only="svelte">
          <div slot="fallback" class="demo-hydration-shell" aria-hidden="true">
            <div class="demo-hydration-top">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="demo-hydration-title"></div>
            <div class="demo-hydration-tone"></div>
            <div class="demo-hydration-wheel">
              <span></span>
            </div>
            <div class="demo-hydration-result"></div>
            <div class="demo-hydration-prompt"></div>
          </div>
        </WebDemoApp>
      </div>
    </div>
  </section>

  <section class="section compact-section" id="features">
    <div class="container">
      <div class="section-header">
        <div class="pill">How It Works</div>
        <h2>AI builds the wheel. The spin settles it.</h2>
        <p>Most wheel apps are just randomizers. Wheelora actually helps you figure out the options first.</p>
      </div>

      <div class="grid-features">
        <article class="feature-card">
          <div class="feature-icon">✨</div>
          <h3>Messy Prompts Welcome</h3>
          <p>Start with "what should we eat?" or "what chore first?" AI cleans it up into actionable, balanced choices.</p>
        </article>
        
        <article class="feature-card">
          <div class="feature-icon">🎯</div>
          <h3>Smart Weighting</h3>
          <p>Not every outcome should be equally likely. AI balances options so you can actually trust the result.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">⚖️</div>
          <h3>Flawless Spin Physics</h3>
          <p>Beautiful, momentum-based physics imported directly from our native app for the most satisfying spin.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="tones">
    <div class="container">
      <div class="section-header">
        <div class="pill">Tone Engine</div>
        <h2>Change the vibe with a single tap.</h2>
        <p style="margin-bottom: 0.5rem;">Wheelora writes the wheel differently depending on what energy you need right now.</p>
      </div>

      <div class="tone-grid">
        {aiTones.map((tone) => (
          <article class="tone-card" style={`--tone-color: ${tone.color}`}>
            <div class="tone-icon">{tone.emoji}</div>
            <h3>{tone.label}</h3>
            <p>{tone.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="themes">
    <div class="container">
      <div class="section-header">
        <div class="pill">Premium Themes</div>
        <h2>Match your vibe exactly.</h2>
        <p>Wheelora comes with unique, beautifully crafted themes that give you a premium feel.</p>
      </div>

      <ThemeShowcase client:visible />
    </div>
  </section>

  <section class="section" id="starter-packs">
    <div class="container">
      <div class="section-header">
        <div class="pill">Starter Packs</div>
        <h2>Start from the kind of stuck you are.</h2>
        <p>Launch useful wheels for dinner, focus, low-energy routines, and group plans without facing a blank page.</p>
      </div>

      <div class="starter-grid">
        {starterPacks.map((pack) => (
          <article class="starter-card">
            <div class="starter-emoji">{pack.emoji}</div>
            <h3>{pack.title}</h3>
            <p>{pack.blurb}</p>
            <div class="tag-row">
              {pack.pills.map((pill) => <span>{pill}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section utility-band" id="plans">
    <div class="container utility-grid">
      <div>
        <div class="pill">Plans</div>
        <h2>Free stays useful. Pro goes deeper.</h2>
      </div>
      <div class="plan-list">
        <article>
          <strong>Free</strong>
          <p>Guest mode, local wheels, starter decisions, the core spin flow, and rewarded ad unlocks when you need extra AI generation.</p>
        </article>
        <article>
          <strong>Pro</strong>
          <p>More wheels, more AI, sync, restore, and heavier everyday decision workflows.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="use-cases">
    <div class="container">
      <div class="section-header">
        <div class="pill">Everyday Decisions</div>
        <h2>Built for the choices that keep stealing attention.</h2>
      </div>
      <div class="life-grid">
        {lifeAreas.map((area) => (
          <article>
            <h3>{area.title}</h3>
            <p>{area.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section" id="waitlist">
    <div class="container">
      <h2>Join the waitlist</h2>
      <p>We’ll email you when Wheelora is ready.</p>
      <form class="waitlist-form" data-waitlist-form>
        <label class="sr-only" for="waitlist-email">Email address</label>
        <input
          id="waitlist-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
        />
        <button class="button button-primary" type="submit">Notify me</button>
      </form>
      <p class="waitlist-status" data-waitlist-status aria-live="polite"></p>
    </div>
  </section>

  <script>
    const form = document.querySelector("[data-waitlist-form]") as HTMLFormElement | null;
    const status = document.querySelector("[data-waitlist-status]") as HTMLElement | null;
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const emailInput = form.querySelector("input[name='email']") as HTMLInputElement | null;
      const button = form.querySelector("button") as HTMLButtonElement | null;
      const email = emailInput?.value.trim() ?? "";

      if (!emailPattern.test(email)) {
        if (status) {
          status.textContent = "Please enter a valid email address.";
          status.dataset.state = "error";
        }
        emailInput?.focus();
        return;
      }

      if (button) button.disabled = true;
      if (status) {
        status.textContent = "Saving your spot...";
        status.dataset.state = "pending";
      }

      try {
        const response = await fetch("/api/v1/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, source: "homepage" }),
        });

        if (!response.ok) {
          throw new Error("Waitlist request failed");
        }

        form.reset();
        if (status) {
          status.textContent = "You're on the list. We'll notify you when the app is ready.";
          status.dataset.state = "success";
        }
      } catch {
        if (status) {
          status.textContent = "We could not save that email right now. Please try again.";
          status.dataset.state = "error";
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  </script>
</BaseLayout>
