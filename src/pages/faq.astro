---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqs } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((entry) => ({
    "@type": "Question",
    name: entry.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: entry.a,
    },
  })),
};
---

<BaseLayout
  title="Wheelora™ FAQ | AI Decision Wheels, Sync, Sharing & Pro"
  description="Answers about Wheelora™ AI decision wheels, weighted spins, local-first guest mode, free sync, sharing, themes, rewarded unlocks, and Pro limits."
  canonicalPath="/faq"
  structuredData={[faqSchema]}
>
  <section class="faq-shell" id="faq">
    <div class="container faq-layout">
      <div class="section-head faq-head">
        <span class="eyebrow">FAQ</span>
        <h1>Wheelora™ frequently asked questions</h1>
        <p>
          Want to see it first? Try the <a href="/#demo">live sample wheel</a> or compare
          <a href="/#plans"> Free and Pro</a>.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((entry, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{entry.q}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p>{entry.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
