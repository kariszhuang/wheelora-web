---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SharedWheelViewer from "../../components/svelte/SharedWheelViewer.svelte";
import { site } from "../../data/site";
---

<BaseLayout
  title="Shared Wheel | Wheelora™"
  canonicalPath="/w"
  deferSeo={true}
>
  <Fragment slot="head">
    __SHARED_WHEEL_HEAD__
    <style>
      .sw-page {
        min-height: 70vh;
        padding: clamp(2.5rem,5vw,4.5rem) 0 clamp(3.5rem,7vw,6rem);
      }

      .sw-inner {
        margin: 0 auto;
        max-width: 760px;
        padding: 0 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
      }

      /* Ghost SEO block */
      .sr-only-meta {
        position: absolute; width: 1px; height: 1px;
        padding: 0; margin: -1px; overflow: hidden;
        clip: rect(0,0,0,0); white-space: nowrap; border: 0;
      }

      /* Eyebrow */
      .sw-eyebrow {
        display: inline-flex; align-items: center; gap: 0.35rem;
        font-size: 0.73rem; font-weight: 850; letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--teal);
        background: var(--teal-soft);
        border: 1px solid #a8cec7;
        border-radius: 999px;
        padding: 0.36rem 0.8rem;
      }

      /* Wheel island wrapper */
      .sw-wheel { width: 100%; }

      /* App acquisition */
      .sw-acquisition {
        background:
          radial-gradient(circle at 85% 15%, rgba(114,209,201,.22), transparent 34%),
          var(--ink);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 28px;
        box-shadow: 0 22px 55px rgba(22,32,42,.16);
        color: white;
        display: grid;
        gap: 1.25rem;
        overflow: hidden;
        padding: clamp(1.35rem,4vw,2rem);
        position: relative;
        width: 100%;
      }

      .sw-acquisition-copy {
        align-items: flex-start;
        display: grid;
        gap: .55rem;
      }

      .sw-acquisition-kicker {
        color: #72d1c9;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .11em;
        text-transform: uppercase;
      }

      .sw-acquisition h2 {
        color: white;
        font: 500 clamp(1.8rem,5vw,2.55rem)/1 Georgia,serif;
        letter-spacing: -.035em;
        margin: 0;
      }

      .sw-acquisition p {
        color: #c8c4bc;
        font-size: .95rem;
        line-height: 1.6;
        margin: 0;
        max-width: 38rem;
      }

      .sw-install-note {
        color: #eee9df !important;
        font-size: .82rem !important;
        font-weight: 700;
      }

      .sw-cta-row {
        display: flex; gap: 0.65rem; flex-wrap: wrap;
      }

      .btn-primary {
        background: #72d1c9; color: #10242a;
        border-radius: 999px; padding: 0.8rem 1.75rem;
        font: inherit; font-weight: 800; font-size: 0.95rem;
        text-decoration: none; border: none; cursor: pointer;
        transition: transform 0.18s, box-shadow 0.18s;
        display: inline-flex; align-items: center; gap: 0.4rem;
        min-height: 44px;
      }
      .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 12px 28px rgba(22,32,42,0.18); }

      .btn-ghost {
        background: rgba(255,255,255,.08); color: white;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 999px; padding: 0.8rem 1.5rem;
        font: inherit; font-weight: 700; font-size: 0.95rem;
        text-decoration: none; cursor: pointer;
        transition: background 0.18s, transform 0.18s;
        display: inline-flex; align-items: center; gap: 0.4rem;
        min-height: 44px;
      }
      .btn-ghost:hover { background: rgba(255,255,255,.14); transform: translateY(-1px); }

      .sw-divider {
        width: 100%; height: 1px;
        background: var(--line); border: none; margin: 0;
      }

      @media (max-width: 480px) {
        .sw-cta-row { flex-direction: column; align-items: stretch; }
        .btn-primary, .btn-ghost { justify-content: center; }
      }
    </style>
  </Fragment>

  <!-- Server-injected JSON data for the Svelte island -->
  <script id="shared-wheel-json" type="application/json">__SHARED_WHEEL_JSON__</script>

  <!-- Ghost SEO block — invisible to humans, readable by crawlers/LLMs -->
  <div class="sr-only-meta" aria-hidden="true">__SHARED_WHEEL_CONTENT__</div>

  <article class="sw-page">
    <div class="sw-inner">

      <div class="sw-eyebrow">✦ Wheelora shared wheel</div>

      <!-- Svelte island: renders wheel + title + AI badge + theme tabs + engagement -->
      <div class="sw-wheel">
        <SharedWheelViewer client:only="svelte" />
      </div>

      <hr class="sw-divider" />

      <section class="sw-acquisition" aria-label="Get Wheelora for this shared wheel">
        <div class="sw-acquisition-copy">
          <span class="sw-acquisition-kicker">Keep this wheel</span>
          <h2 id="sw-acquisition-title-released">Save a copy in Wheelora.</h2>
          <p class="sw-install-note">
            Open this exact wheel—or install, then return here.
          </p>
        </div>
        <div class="sw-cta-row">
          <a
            class="btn-primary"
            href="__SHARED_WHEEL_APP_URL__"
            data-app-url="__SHARED_WHEEL_APP_URL__"
            data-open-wheelora
          >
            Open in Wheelora <span aria-hidden="true">↗</span>
          </a>
          <a
            class="btn-ghost"
            href={site.appStoreUrl}
          >
            App Store
          </a>
          <button
            class="btn-ghost"
            type="button"
            id="sw-copy-btn"
            aria-live="polite"
          >
            Copy link
          </button>
        </div>
      </section>

    </div>
  </article>

  <script>
    // Copy link
    const copyBtn = document.getElementById("sw-copy-btn");
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        copyBtn.textContent = "✓ Copied!";
        setTimeout(() => { copyBtn.textContent = "Copy link"; }, 2000);
      } catch {
        copyBtn.textContent = "Copy link";
      }
    });
  </script>
</BaseLayout>
