---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalDocument from "../components/LegalDocument.astro";

const legalApiBase =
  import.meta.env.PUBLIC_LEGAL_API_BASE?.trim() || "";
---

<BaseLayout
  title="Wheelora™ | Privacy Policy"
  description="Read Wheelora™ Privacy Policy on wheelora.ai."
  canonicalPath="/privacy"
>
  <LegalDocument
    title="Privacy Policy"
    eyebrow="Privacy"
    intro="This page stays on wheelora.ai and renders legal content provided by the Wheelora™ backend API."
    docPath="privacy-policy"
    fallbackApiBase={legalApiBase}
  />
</BaseLayout>
